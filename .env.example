# Optional: enables broad web recipe search through Brave Search.
BRAVE_SEARCH_API_KEY=
# Optional TheMealDB key. Development key 1 is used if this variable is empty.
THEMEALDB_API_KEY=1

# Server-side AI recipe generation. Never add the NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Supabase Auth + per-account pantry, favorites and saved recipes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
